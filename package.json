{
  "name": "cultureforge-ai",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test:contracts": "node scripts/verify_contracts.mjs",
    "test:backend": ".venv/bin/python -m pytest backend/tests -q",
    "test:walkthrough": "node scripts/verify_walkthrough.mjs",
    "check:api": "python3 scripts/check_api.py",
    "test:endpoints": "node scripts/verify_endpoints.mjs",
    "check:submission": "node scripts/verify_submission.mjs",
    "check:release": "node scripts/verify_submission.mjs --release",
    "test:unit": "node scripts/test_unit.mjs",
    "smoke": "python3 scripts/smoke_test.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "6.12.0",
    "motion": "^14.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "8.72.0",
    "vite": "^6.4.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  }
}
