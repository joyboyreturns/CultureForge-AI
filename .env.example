# CultureForge AI — Environment Configuration

# ------------------------------------------------------------------------------
# Qloo Hackathon API Key
# ------------------------------------------------------------------------------
# When you receive your API key from the hackathon organizers, paste it below:
QLOO_API_KEY=your_qloo_api_key_here

# ------------------------------------------------------------------------------
# Provider Mode
# ------------------------------------------------------------------------------
# Options:
#   auto - automatically use Qloo if key/config is found, otherwise fallback to mock
#   qloo - force live Qloo mode (fails with helpful message if key is missing)
#   mock - force mock mode (no API calls)
CULTUREFORGE_PROVIDER=auto

# ------------------------------------------------------------------------------
# Optional LLM Model Provider Keys (if using Qloo Agentic chat or integrations)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GEMINI_API_KEY=your_gemini_key_here
