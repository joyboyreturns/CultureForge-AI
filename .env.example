# CultureForge AI — Environment Configuration

# ------------------------------------------------------------------------------
# Qloo Hackathon API Key
# ------------------------------------------------------------------------------
# Recommended: keep the key in the Qloo CLI's own private credential store
# (~/.qloo/config, mode 0600) rather than in this file:
#
#   qloo config set api-key YOUR_QLOO_API_KEY
#   qloo config set base-url https://hackathon.api.qloo.com
#
# The base URL is required. Hackathon keys work ONLY against
# https://hackathon.api.qloo.com; against api.qloo.com or
# staging.api.qloo.com they return 401. It is set in the CLI config because
# the CLI also needs it to trust the endpoint.
#
# Alternatively, provide the key here and let the backend pass it to the CLI:
QLOO_API_KEY=your_qloo_api_key_here

# ------------------------------------------------------------------------------
# Provider Mode
# ------------------------------------------------------------------------------
# Options:
#   auto - use Qloo; a key is required, and without one the API says so
#   qloo - force live Qloo mode (fails with helpful message if key is missing)
#   mock - force mock mode (the test fixture; no API calls)
CULTUREFORGE_PROVIDER=auto

# ------------------------------------------------------------------------------
# Run profile
# ------------------------------------------------------------------------------
# One switch decides how careful the server is with quota (backend/config.py):
#   dev      - the local call budgets below are enforced (default)
#   judging  - every call-count budget is off, for Qloo and the model gateway
# Judging keeps the per-request timeouts, the stated handling of 429/401/5xx,
# the pause after a 429, single-flight de-duplication and the evidence cache.
# Qloo's own server-side quota still applies: run scripts/prewarm.py first.
RUN_PROFILE=dev

# Emergency switch, either profile: false serves held evidence only and makes
# no new Qloo request.
QLOO_LIVE_ENABLED=true

# After Qloo answers 429, live calls pause this long instead of retrying.
QLOO_RATE_LIMIT_COOLDOWN_SECONDS=60

# How long held evidence answers before it is fetched again. Unset: 24 hours
# in dev, 336 hours (14 days) in judging, so prewarmed evidence lasts.
# CULTUREFORGE_EVIDENCE_TTL_HOURS=24

# ------------------------------------------------------------------------------
# Quota guard (dev profile only)
# ------------------------------------------------------------------------------
# Hackathon keys carry rate and monthly limits that Qloo does not publish.
# In the dev profile these caps bound how many Qloo workflows this backend may
# issue, so a runaway rehearsal cannot exhaust the quota. Each workflow costs
# at least one request; held evidence is free.
#
# A brief uses find_tags and recommend, plus one recommend per audience-bridge
# domain (CULTUREFORGE_BRIDGE_DOMAINS, below). A full three-direction challenge
# adds one ranking call and up to three tag comparisons. Optional agent tests
# and investigations can add calls. Never raise these to work around a
# failure; switch to RUN_PROFILE=judging deliberately instead.
QLOO_MAX_CALLS_PER_HOUR=20
QLOO_MAX_CALLS_PER_DAY=100

# The most Qloo workflows one research run may spend (dev only; judging bounds
# a run by its 240-second deadline instead): seeds, places, one per
# audience-bridge domain, and what is left for the agent loop's live calls.
RESEARCH_RUN_MAX_WORKFLOWS=8

# The other domains the audience's tags are also sent to, with no location,
# so directions can cite what else the audience gravitates to. Each domain is
# one cached recommend request. Comma-separated; off switches the bridge off.
# Choices: artist, movie, brand, book, podcast, tv_show, videogame, album.
CULTUREFORGE_BRIDGE_DOMAINS=artist,movie,brand

# Per-request timeout for the Qloo API in milliseconds. The stock qloo CLI caps
# requests at 20000ms, which is shorter than /v2/insights needs against the
# hackathon environment; scripts/qloo_exec.mjs applies this value and disables
# the CLI's blind 3-attempt retry.
QLOO_REQUEST_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# Frontier AI via Vercel AI Gateway (optional)
# ------------------------------------------------------------------------------
# The same server-side provider powers bounded naming, evidence selection,
# agent planning/reflection, and manual evidence analysis. Keep the key out of
# source control and the browser. All model features remain off by default.
AI_GATEWAY_ENABLED=false
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
# The model name the studio and the trace show. Unset: the Gateway model id
# above, as configured. Set it only to give the same model a readable name.
AI_GATEWAY_DISPLAY_MODEL=
AI_GATEWAY_ANALYSIS_DAILY_LIMIT=10

# Local guard for naming/evidence-selection requests (dev profile only).
# Successful and malformed Gateway responses count; unavailable rule-based
# output remains the fallback. The analysis allowance above can be lowered in
# dev but not raised past 10.
LLM_MAX_CALLS_PER_HOUR=20
LLM_MAX_CALLS_PER_DAY=50
LLM_TIMEOUT_SECONDS=30

# Production: built frontend and durable single-instance state. Docker sets
# these paths automatically. Leave unset for the two-process development setup.
# CULTUREFORGE_STATIC_DIR=/app/dist
# CULTUREFORGE_CACHE_DIR=/data/cache
# CULTUREFORGE_DB=/data/platform.db
# CULTUREFORGE_OPERATOR_TOKEN=generate-a-private-operator-token
