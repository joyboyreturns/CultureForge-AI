# CultureForge AI — Environment Configuration

# ------------------------------------------------------------------------------
# Qloo Hackathon API Key
# ------------------------------------------------------------------------------
# Recommended: keep the key in the Qloo CLI's own private credential store
# (~/.qloo/config, mode 0600) rather than in this file:
#
#   qloo config set api-key YOUR_QLOO_API_KEY
#   qloo config set base-url https://hackathon.api.qloo.com
#
# The base URL is required. Hackathon keys work ONLY against
# https://hackathon.api.qloo.com; against api.qloo.com or
# staging.api.qloo.com they return 401. It is set in the CLI config because
# the CLI also needs it to trust the endpoint.
#
# Alternatively, provide the key here and let the backend pass it to the CLI:
QLOO_API_KEY=your_qloo_api_key_here

# ------------------------------------------------------------------------------
# Provider Mode
# ------------------------------------------------------------------------------
# Options:
#   auto - use Qloo; a key is required, and without one the API says so
#   qloo - force live Qloo mode (fails with helpful message if key is missing)
#   mock - force mock mode (the test fixture; no API calls)
CULTUREFORGE_PROVIDER=auto

# ------------------------------------------------------------------------------
# Quota guard
# ------------------------------------------------------------------------------
# Hackathon keys carry rate and monthly limits that Qloo does not publish.
# These caps bound how many Qloo workflows this backend may issue, so a runaway
# demo cannot exhaust the quota. Each workflow costs at least one request.
#
# A basic brief uses find_tags and recommend. A full three-direction challenge
# adds one ranking call and up to three tag comparisons. Optional agent tests
# and investigations can add calls; held evidence is free. These match the
# provider's conservative defaults. Never raise them to work around a failure.
QLOO_MAX_CALLS_PER_HOUR=20
QLOO_MAX_CALLS_PER_DAY=100

# Per-request timeout for the Qloo API in milliseconds. The stock qloo CLI caps
# requests at 20000ms, which is shorter than /v2/insights needs against the
# hackathon environment; scripts/qloo_exec.mjs applies this value and disables
# the CLI's blind 3-attempt retry.
QLOO_REQUEST_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# Frontier AI via Vercel AI Gateway (optional)
# ------------------------------------------------------------------------------
# The same server-side provider powers bounded naming, evidence selection,
# agent planning/reflection, and manual evidence analysis. Keep the key out of
# source control and the browser. All model features remain off by default.
AI_GATEWAY_ENABLED=false
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_ANALYSIS_DAILY_LIMIT=10

# Local guard for naming/evidence-selection requests. Successful and malformed
# Gateway responses count; unavailable rule-based output remains the fallback.
LLM_MAX_CALLS_PER_HOUR=20
LLM_MAX_CALLS_PER_DAY=50
LLM_TIMEOUT_SECONDS=30

# Production: built frontend and durable single-instance state. Docker sets
# these paths automatically. Leave unset for the two-process development setup.
# CULTUREFORGE_STATIC_DIR=/app/dist
# CULTUREFORGE_CACHE_DIR=/data/cache
# CULTUREFORGE_DB=/data/platform.db
# CULTUREFORGE_OPERATOR_TOKEN=generate-a-private-operator-token
