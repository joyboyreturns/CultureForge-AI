# CultureForge AI — Environment Configuration

# ------------------------------------------------------------------------------
# Qloo Hackathon API Key
# ------------------------------------------------------------------------------
# Recommended: keep the key in the Qloo CLI's own private credential store
# (~/.qloo/config, mode 0600) rather than in this file:
#
#   qloo config set api-key YOUR_QLOO_API_KEY
#   qloo config set base-url https://hackathon.api.qloo.com
#
# The base URL is required. Hackathon keys work ONLY against
# https://hackathon.api.qloo.com; against api.qloo.com or
# staging.api.qloo.com they return 401. It is set in the CLI config because
# the CLI also needs it to trust the endpoint.
#
# Alternatively, provide the key here and let the backend pass it to the CLI:
QLOO_API_KEY=your_qloo_api_key_here

# ------------------------------------------------------------------------------
# Provider Mode
# ------------------------------------------------------------------------------
# Options:
#   auto - use Qloo; a key is required, and without one the API says so
#   qloo - force live Qloo mode (fails with helpful message if key is missing)
#   mock - force mock mode (the test fixture; no API calls)
CULTUREFORGE_PROVIDER=auto

# ------------------------------------------------------------------------------
# Quota guard
# ------------------------------------------------------------------------------
# Hackathon keys carry rate and monthly limits that Qloo does not publish.
# These caps bound how many Qloo workflows this backend may issue, so a runaway
# demo cannot exhaust the quota. Each workflow costs at least one request.
#
# The caps are set for a room of judges: a brief costs two Qloo calls
# (find_tags and recommend) and testing the directions against the evidence
# costs two more, so a full demo is six. 60 an hour is ten demos an hour for
# everyone at the same time, and 200 a day is thirty-three. Raise them only
# if the key's real allowance is known to be larger.
QLOO_MAX_CALLS_PER_HOUR=60
QLOO_MAX_CALLS_PER_DAY=200

# Per-request timeout for the Qloo API in milliseconds. The stock qloo CLI caps
# requests at 20000ms, which is shorter than /v2/insights needs against the
# hackathon environment; scripts/qloo_exec.mjs applies this value and disables
# the CLI's blind 3-attempt retry.
QLOO_REQUEST_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# Naming the directions with a free model (optional)
# ------------------------------------------------------------------------------
# The composer is a rule engine: a direction inherits the recipe's name, so
# every brief that unlocks the same recipe gets the same title. A free model
# writes the name, the tagline and one sentence of reasoning instead, given
# the venues the direction is built from. It never sees a number, and it
# never chooses the evidence.
#
# The key is free to create and needs no credit: https://openrouter.ai/keys
# The free tier allows 50 requests a day, or 1000 once $10 of credits is on
# the account. One brief costs one request, and the answer is held, so a
# repeated brief costs nothing.
OPENROUTER_API_KEY=

# The model to ask. The free pool is mostly withdrawn or rate limited, and
# the reasoning models spend their whole token budget thinking and answer
# with nothing, so one is pinned: this is the model that has been seen
# answering this prompt directly. `openrouter/free` (the Free Models Router)
# is in the fallback chain for when the pinned model is withdrawn.
# Any other value must be a `:free` model: a paid one is refused, because
# OpenRouter bills a paid model that appears in a chain.
OPENROUTER_MODEL=cohere/north-mini-code:free

# Optional, explicit judge-session evidence analysis through Vercel AI Gateway.
# Keep disabled during development; the browser never receives this credential.
AI_GATEWAY_ANALYSIS_ENABLED=false
AI_GATEWAY_API_KEY=
# Set this privately to the model identifier selected for the judge session.
AI_GATEWAY_MODEL=
AI_GATEWAY_ANALYSIS_DAILY_LIMIT=10

# The free allowance is finite, so it is guarded locally as well. These caps
# sit under the tier's own limit (50 a day) so a busy demo cannot spend the
# last of it.
LLM_MAX_CALLS_PER_HOUR=20
LLM_MAX_CALLS_PER_DAY=50

# How long to wait for the model. The free tier queues, and a late answer is
# worth less than the rule engine's wording it would have replaced.
LLM_TIMEOUT_SECONDS=20

# ------------------------------------------------------------------------------
# Optional LLM Model Provider Keys (if using Qloo Agentic chat or integrations)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GEMINI_API_KEY=your_gemini_key_here
